{
  "manifest_version": 3,
  "name": "Film Search: Letterboxd and IMDb",
  "version": "1.0.1",
  "description": "Right-click a film title to search Letterboxd or IMDb. Collects nothing. Not affiliated with Letterboxd or IMDb.",
  "permissions": [
    "menus"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/extension-16.png",
    "32": "icons/extension-32.png",
    "48": "icons/extension-48.png",
    "96": "icons/extension-96.png",
    "128": "icons/extension-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b1f021b4-3cc7-4aa4-83a8-59436c0f8fda}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
